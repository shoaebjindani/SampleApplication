	<build>
		<finalName>Attempt10</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
			   NOTE: only ONE git-commit-id plugin declaration should exist.
			   The old coordinates (pl.project13.maven:git-commit-id-plugin)
			   and the current ones (io.github.git-commit-id:git-commit-id-maven-plugin)
			   are two DIFFERENT artifacts. Declaring both makes Maven run both,
			   and only this one below picks up the offline=true setting, so the
			   other one was still trying to fetch from GitHub and failing with
			   "Authentication is required but no CredentialsProvider has been
			   registered". Keeping just this single declaration fixes that.
			-->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>6.0.0</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>initialize</phase>
					</execution>
				</executions>
				<configuration>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
					<commitIdGenerationMode>flat</commitIdGenerationMode>
					<dateFormat>ddMMyyyyHHmm (yyyy-MM-dd HH:mm:ss)</dateFormat>
					<!-- Prevents the plugin from trying to fetch from the remote
					     (which fails in CI/deploy environments without a
					     registered JGit CredentialsProvider). offline=true makes
					     it use only local git refs. -->
					<offline>true</offline>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<goals>
					<goal>java</goal>
				</goals>
				<configuration>
					<mainClass>com.crystal.SpringBootServletJspApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>


		<resources>
			
			<resource>
				<directory>src/main/java/Frameworkpackage/frameworkjsps</directory>
				<targetPath>META-INF/resources/frameworkjsps</targetPath>
				<includes>
					<include>**/*.js*</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/java/Frameworkpackage/frameworkjsps</directory>
				<targetPath>${basedir}/target/Attempt10/frameworkjsps/</targetPath>
				<includes>
					<include>**/*.*</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/resources/META-INF/resources/</directory>
				<targetPath>${basedir}/target/Attempt10/</targetPath>
				<includes>
					<include>**/*.*</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/resources/</directory>
				<targetPath>${basedir}/target/classes/</targetPath>
				<includes>
					<include>**/*.*</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/java/com/crystal/customizedpos/Configuration/</directory>
				<targetPath>${basedir}/target/Attempt10/WEB-INF/classes/com/crystal/customizedpos/Configuration</targetPath>
				<includes>
					<include>**/*.yaml</include>
					<include>**/*.sql</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/java/pdfGeneration</directory>
				<targetPath>${basedir}/target/Attempt10/WEB-INF/classes/pdfGeneration</targetPath>
				<includes>
					<include>**/*.png</include>
					<include>**/*.jpg</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/java/com/crystal/customizedpos/Configuration/</directory>
				<targetPath>${basedir}/target/classes/com/crystal/customizedpos/Configuration</targetPath>
				<includes>
					<include>**/*.yaml</include>
					<include>**/*.sql</include>
				</includes>
			</resource>

			<resource>
				<directory>src/main/java/pdfGeneration</directory>
				<targetPath>${basedir}/target/classes/pdfGeneration</targetPath>
				<includes>
					<include>**/*.png</include>
					<include>**/*.jpg</include>
				</includes>
			</resource>
		</resources>

	</build>

</project>